# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env de verdade — ele já está no .gitignore/.dockerignore.

# Postgres — role de bootstrap (dono das tabelas, criada automaticamente pela
# imagem oficial do Postgres; é sempre superusuário, por isso só é usada pra
# migração/schema, nunca pra servir requisição — superusuário ignora RLS sempre)
POSTGRES_USER=koren
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=koren_driver

# Senha da role de runtime (koren_app), SEM privilégio de superusuário — é essa
# role que a aplicação usa de verdade, e é o que faz o RLS funcionar
APP_DB_PASSWORD=troque-esta-outra-senha

# Domínio(s) que podem chamar a API, separados por vírgula (sem barra no final)
# Exemplo em produção: https://app.korendriver.com,https://korendriver.com
ALLOWED_ORIGINS=http://localhost:3000

# 'production' esconde detalhes de erro do cliente; deixe vazio/'development' localmente
NODE_ENV=production

PORT=3000

# Login do Super Admin — se deixar vazio, sobe com superadmin@koren.app/koren@2026
# (só pra demo). Em produção, sempre defina os dois.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Evolution API (WhatsApp self-hospedado, infraestrutura compartilhada da
# Korentech) — usada pra mandar a mensagem de boas-vindas quando um motorista
# se cadastra. Se ficar vazio, o app funciona normal, só não manda a mensagem.
EVOLUTION_API_URL=http://evolution.korentech.com.br:8085
EVOLUTION_API_KEY=troque-por-uma-chave-de-verdade
EVOLUTION_INSTANCE_NAME=Korendriver
